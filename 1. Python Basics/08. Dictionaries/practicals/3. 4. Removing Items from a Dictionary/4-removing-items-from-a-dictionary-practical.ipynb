    "\n",
    "# Import marking system\n",
    "import marking_system\n",
    "import importlib\n",
    "importlib.reload(marking_system)\n",
    "\n",
    "# Setup custom error handling\n",
    "import sys\n",
    "ipython = get_ipython()\n",
    "def hide_traceback(exc_tuple=None, filename=None, tb_offset=None, exception_only=False, running_compiled_code=False):\n",
    "    etype, value, tb = sys.exc_info()\n",
    "    value.__cause__ = None\n",
    "    return ipython._showtraceback(etype, '❌ ' + f'\\033[91m{value}', ipython.InteractiveTB.get_exception_only(etype, '❌ ' + f'\\033[91m{value}'))\n",
    "ipython.showtraceback = hide_traceback\n",
    "\n",
    "print('✅ Setup complete! You can now run the rest of the notebook.')"
   ]
  },
